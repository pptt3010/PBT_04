CSS:

/* RESET */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* ================= NAVBAR ================= */
.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 60px;
  padding: 0 20px;
  background: #222;
}

/* LOGO */
.logo {
  color: white;
  font-weight: bold;
  font-size: 18px;
}

/* MENU GIỮA */
.menu {
  list-style: none;
  display: flex;
  gap: 30px;
}

.menu a {
  color: white;
  text-decoration: none;
  padding-bottom: 3px;
  transition: 0.2s;
}

/* hover navbar */
.menu a:hover {
  color: #00d4ff;
  border-bottom: 2px solid #00d4ff;
}

/* AUTH */
.auth {
  display: flex;
  gap: 15px;
}

.auth a {
  color: white;
  text-decoration: none;
  border: 1px solid white;
  padding: 6px 10px;
  border-radius: 4px;
  transition: 0.2s;
}

.auth a:hover {
  background: white;
  color: #222;
}

/* ================= PRODUCT GRID ================= */
.container {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  padding: 20px;
}

/* CARD (4 CỘT) */
.card {
  flex: 0 0 calc(25% - 20px);
  display: flex;
  flex-direction: column;

  border: 1px solid #ddd;
  border-radius: 8px;
  padding: 10px;
  background: white;

  transition: 0.3s;
}

/* IMAGE */
.card img {
  width: 100%;
  border-radius: 6px;
}

/* PRICE */
.price {
  color: red;
  font-weight: bold;
  margin: 5px 0;
}

/* BUTTON luôn ở đáy */
.card button {
  margin-top: auto;
  padding: 8px;
  border: none;
  background: #222;
  color: white;
  border-radius: 4px;
  cursor: pointer;
}

/* HOVER CARD */
.card:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 20px rgba(0,0,0,0.2);
}
